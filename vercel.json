{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/gojo/research", "destination": "/research/gojo/stocks/", "permanent": true },
    { "source": "/gojo/research/", "destination": "/research/gojo/stocks/", "permanent": true },
    { "source": "/gojo", "destination": "/research/gojo/", "permanent": true },
    { "source": "/gojo/:path*", "destination": "/research/gojo/:path*", "permanent": true },
    { "source": "/lelouch", "destination": "/research/lelouch/", "permanent": true },
    { "source": "/lelouch/:path*", "destination": "/research/lelouch/:path*", "permanent": true },
    { "source": "/moneyhub/analysis.html", "destination": "/moneyhub/market-lab/", "permanent": true },
    { "source": "/moneyhub/portfolio.html", "destination": "/moneyhub/market-lab/", "permanent": true },
    { "source": "/moneyhub/trading-journal.html", "destination": "/moneyhub/market-lab/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/research/lelouch/:path*", "destination": "/lelouch/:path*" }
  ]
}
